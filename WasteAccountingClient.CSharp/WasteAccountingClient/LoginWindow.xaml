<Window x:Class="WasteAccountingClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        SizeToContent="Height"
        Width="480"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#e8f4f3">
    <Grid Margin="24">
        <Border Background="White" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Width="432">
            <StackPanel>
                <Border Background="{StaticResource HeaderGradient}"
                        CornerRadius="20,20,0,0" Padding="24,26,24,22">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#ffffff28" Margin="0,0,0,14">
                            <TextBlock Text="♻" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Учёт промышленных отходов"
                                   FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="28,26,28,24">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailInput" Height="44" Margin="0,0,0,16"/>

                    <TextBlock Text="Пароль" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput" Height="44" Margin="0,0,0,20"
                                 KeyDown="PasswordInput_KeyDown"/>

                    <Button x:Name="LoginButton" Content="Войти в систему"
                            Style="{StaticResource PrimaryButton}" Height="46"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
