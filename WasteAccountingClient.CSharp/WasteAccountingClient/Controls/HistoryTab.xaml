<UserControl x:Class="WasteAccountingClient.Controls.HistoryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="История поступлений" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Все зарегистрированные партии отходов на складе (данные обновляются автоматически)"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </Grid>
                <Border Background="#f8fafc" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Поиск" Style="{StaticResource FilterLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchInput" Width="280" Margin="0,0,12,0"
                                 VerticalContentAlignment="Center" Height="32"
                                 ToolTip="Код, наименование, цех, статус"
                                 TextChanged="SearchInput_TextChanged"/>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Padding="14,8" Click="ResetSearch_Click"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource ContentCard}">
            <DataGrid x:Name="BatchesGrid" Style="{StaticResource DataGridStyle}"/>
        </Border>
    </DockPanel>
</UserControl>
