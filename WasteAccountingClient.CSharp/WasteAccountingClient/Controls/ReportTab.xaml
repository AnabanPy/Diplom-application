<UserControl x:Class="WasteAccountingClient.Controls.ReportTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCard}">
            <StackPanel>
                <TextBlock Text="Отчёты и аналитика" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Фильтры применяются автоматически; экспорт — в файл по вашему пути"
                           Style="{StaticResource PageSubtitle}"/>

                <Border Background="#f8fafc" CornerRadius="10" Padding="14" Margin="0,14,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Дата от" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="DateFrom" Width="140" Margin="0,0,20,0"
                                        SelectedDateChanged="DateFilter_Changed"/>
                            <TextBlock Text="Дата до" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="DateTo" Width="140" Margin="0,0,20,0"
                                        SelectedDateChanged="DateFilter_Changed"/>
                            <TextBlock Text="Статус" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="StatusCombo" Width="160" Margin="0,0,20,0"
                                      SelectionChanged="FilterCombo_Changed"/>
                            <TextBlock Text="Цех" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="DepartmentCombo" Width="160" Margin="0,0,20,0"
                                      SelectionChanged="FilterCombo_Changed"/>
                            <Button Content="Сбросить фильтры" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Padding="14,8" Click="ResetFilters_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Поиск" Style="{StaticResource FilterLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchInput" Width="320" Margin="0,0,12,0" Height="32"
                                     VerticalContentAlignment="Center"
                                     ToolTip="По коду, наименованию, ФККО, цеху, статусу"
                                     TextChanged="SearchInput_TextChanged"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DashboardPanel" Background="#ecfdf5" CornerRadius="8" Padding="12,8"
                        Margin="0,12,0,0" BorderBrush="#6ee7b7" BorderThickness="1">
                    <TextBlock x:Name="DashboardText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Excel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="ExportExcel_Click"/>
                    <Button Content="Word (акт)" Style="{StaticResource SecondaryButton}"
                            Click="ExportWord_Click"/>
                </StackPanel>

                <TextBlock x:Name="InfoLabel" Margin="0,12,0,0" FontSize="12"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource ContentCard}">
            <DataGrid x:Name="ReportGrid" Style="{StaticResource DataGridStyle}"/>
        </Border>
    </DockPanel>
</UserControl>
