<UserControl x:Class="WasteAccountingClient.Controls.OperationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCard}">
            <StackPanel>
                <TextBlock Text="Операции с отходами" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Запись переработки и вывоза — данные видны в других модулях платформы"
                           Style="{StaticResource PageSubtitle}"/>

                <Border Background="#f8fafc" CornerRadius="10" Padding="14" Margin="0,14,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Партия" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="BatchCombo" Height="36" Margin="0,0,0,12"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="BatchCombo_SelectionChanged"/>

                            <TextBlock Text="Тип операции" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="OperationTypeCombo" Height="36" Margin="0,0,0,12"/>

                            <TextBlock Text="Количество (тонн)" Style="{StaticResource FilterLabel}"/>
                            <TextBox x:Name="QuantityInput" Height="36" Margin="0,0,0,12"/>

                            <TextBlock Text="Примечание" Style="{StaticResource FilterLabel}"/>
                            <TextBox x:Name="NotesInput" Height="36" Margin="0,0,0,12"/>

                            <Button Content="Записать операцию" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Click="SaveOperation_Click"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Баланс партии" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                <TextBlock x:Name="BalanceReceived" Margin="0,0,0,6"/>
                                <TextBlock x:Name="BalanceProcessed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="BalanceDisposed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="BalanceRemaining" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ContentCard}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Журнал операций" FontWeight="SemiBold"
                           FontSize="14" Margin="0,0,0,10"/>
                <DataGrid x:Name="OperationsGrid" Style="{StaticResource DataGridStyle}"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
