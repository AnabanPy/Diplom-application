<UserControl x:Class="WasteAccountingClient.Controls.FkkoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Справочник ФККО" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Виды отходов с кодами Федерального классификационного каталога"
                               Style="{StaticResource PageSubtitle}"/>
                    <TextBlock x:Name="InfoLabel" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource ContentCard}">
            <DataGrid x:Name="FkkoGrid" Style="{StaticResource DataGridStyle}"/>
        </Border>
    </DockPanel>
</UserControl>
