<UserControl x:Class="WasteAccountingClient.Controls.RegisterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel>
            <Border Style="{StaticResource ToolbarCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Регистрация партии" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Выберите вид отхода из справочника ФККО и укажите параметры партии"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Справочник ФККО" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBox x:Name="SearchInput" Margin="0,0,0,10"
                                 TextChanged="SearchInput_TextChanged"/>
                        <ListBox x:Name="WasteList" MinHeight="280" MaxHeight="360"
                                 SelectionChanged="WasteList_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Данные партии" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Код партии" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="CodeInput" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="NameInput" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Код ФККО" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="FkkoInput" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Класс опасности" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="HazardCombo" Grid.Row="3" Grid.Column="1" Margin="0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Объём" Style="{StaticResource FormLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <TextBox x:Name="VolumeInput" Width="120"/>
                                <ComboBox x:Name="UnitCombo" Width="100" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Срок хранения, ч" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="DeadlineInput" Grid.Row="5" Grid.Column="1" Text="48" Margin="0,6"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Цех-источник" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="SourceInput" Grid.Row="6" Grid.Column="1" Margin="0,6"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Зарегистрировать" Style="{StaticResource SuccessButton}"
                                    MinWidth="160" Margin="0,0,10,0" Click="Save_Click"/>
                            <Button Content="Очистить" Style="{StaticResource SecondaryButton}"
                                    MinWidth="100" Click="Clear_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
