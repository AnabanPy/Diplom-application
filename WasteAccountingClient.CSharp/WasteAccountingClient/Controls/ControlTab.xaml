<UserControl x:Class="WasteAccountingClient.Controls.ControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="4">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Контроль классификации" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Партии со статусом «Принят», ожидающие подтверждения"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Подтвердить" Style="{StaticResource SuccessButton}"
                            Margin="0,0,10,0" Click="Confirm_Click"/>
                    <Button Content="Отклонить" Style="{StaticResource DangerButton}"
                            Click="Reject_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource ContentCard}">
            <DataGrid x:Name="PendingGrid" Style="{StaticResource DataGridStyle}"/>
        </Border>
    </DockPanel>
</UserControl>
