<Window x:Class="WasteAccountingClient.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Width="440" SizeToContent="Height"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="20,18,20,20" Margin="20">
        <StackPanel>
            <TextBlock x:Name="PromptText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="InputText" MinHeight="36" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="96"
                        Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="96" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
