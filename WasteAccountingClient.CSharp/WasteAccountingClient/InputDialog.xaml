<Window x:Class="WasteAccountingClient.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Height="200" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock x:Name="PromptText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
            <TextBox x:Name="InputText" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="90"
                        Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
